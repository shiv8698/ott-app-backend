# ---- Server ----
PORT=5000
NODE_ENV=development
# Comma-separated list of frontend URLs allowed to call this API (CORS)
CLIENT_URL=http://localhost:5173

# ---- MongoDB Atlas ----
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/reelhouse?retryWrites=true&w=majority

# ---- JWT (use a long random string, 32+ characters) ----
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# ---- Cloudflare R2 (needed from Phase 7) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_VIDEO_BUCKET=reelhouse-videos
R2_IMAGE_BUCKET=reelhouse-images
# Public URL of the image bucket, no trailing slash (e.g. https://pub-xxxx.r2.dev)
R2_IMAGE_PUBLIC_URL=

# ---- Limits ----
MAX_VIDEO_SIZE_MB=500
MAX_IMAGE_SIZE_MB=5
UPLOAD_URL_TTL_SECONDS=900
PLAYBACK_URL_TTL_SECONDS=3600

# ---- Seed script (npm run seed) ----
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123
